<Window x:Class="StockPhotoScout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockPhotoScout"
        Height="900" Width="1500"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,3,12,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#E9EDF3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="StockPhotoScout"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#243247"/>

            <TextBlock Text="Local Stock Photography Review"
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,2,0,12"/>

            <Border Background="White"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Source Folder"
                               VerticalAlignment="Center"
                               Margin="0,0,12,5"/>

                    <TextBox x:Name="SourceFolderTextBox"
                             Grid.Column="1"
                             IsReadOnly="True"/>

                    <Button Grid.Column="2"
                            Content="Browse..."
                            Click="BrowseSource_Click"/>

                    <TextBlock Grid.Row="1"
                               Text="Destination Folder"
                               VerticalAlignment="Center"
                               Margin="0,5,12,0"/>

                    <TextBox x:Name="DestinationFolderTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             IsReadOnly="True"/>

                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Content="Browse..."
                            Click="BrowseDestination_Click"/>
                </Grid>
            </Border>

            <WrapPanel Margin="0,0,0,6">
                <Button Content="Scan Folder"
                        FontWeight="SemiBold"
                        Click="Scan_Click"/>

                <Button Content="Analyze Selected"
                        FontWeight="SemiBold"
                        Click="AnalyzeSelected_Click"/>

                <Button x:Name="CancelButton"
                        Content="Cancel Scan or Analysis"
                        FontWeight="SemiBold"
                        Click="Cancel_Click"
                        IsEnabled="False"
                        Background="#FEE2E2"
                        Foreground="#991B1B"/>

                <Button Content="Reset Filters"
                        Click="ResetFilters_Click"/>

                <Button Content="Select All (Filtered)"
                        Click="SelectAllFiltered_Click"
                        Margin="4"/>

                <Button Content="Deselect All (Filtered)"
                        Click="DeselectAllFiltered_Click"
                        Margin="4"/>

                <Button Content="Copy Selected"
                        Click="CopySelected_Click"/>

                <!-- Kompakte Statusanzeige direkt neben den Buttons -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">

                    <ProgressBar x:Name="ActivitySpinner"
                                 Width="18"
                                 Height="18"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressText"
                                   Text=""
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#2563EB"
                                   Visibility="Collapsed"
                                   MaxWidth="230"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="CountText"
                                   Text="No images scanned"
                                   FontSize="12"
                                   Foreground="#475569"/>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>

            <Border Background="White"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Filters"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,6">
                            <TextBlock Text="Recommendation"
                                       FontWeight="SemiBold"
                                       Margin="4,0,0,4"/>

                            <CheckBox x:Name="RecCandidateCheck"
                                      Content="Candidate"
                                      IsChecked="True"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>

                            <CheckBox x:Name="RecReviewCheck"
                                      Content="Manual Review"
                                      IsChecked="True"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>

                            <CheckBox x:Name="RecUnsuitableCheck"
                                      Content="Likely Unsuitable"
                                      IsChecked="False"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>

                            <CheckBox x:Name="RecNotAnalyzedCheck"
                                      Content="Not Analyzed Yet"
                                      IsChecked="True"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,6">
                            <TextBlock Text="People"
                                       FontWeight="SemiBold"
                                       Margin="4,0,0,4"/>

                            <CheckBox x:Name="PeopleNoneCheck"
                                      Content="None Detected"
                                      IsChecked="True"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>

                            <CheckBox x:Name="PeopleDetectedCheck"
                                      Content="People Detected"
                                      IsChecked="True"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>

                            <CheckBox x:Name="PeopleUnclearCheck"
                                      Content="Identifiability Unclear"
                                      IsChecked="True"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,0,6">
                            <TextBlock Text="Release Status"
                                       FontWeight="SemiBold"
                                       Margin="4,0,0,4"/>

                            <CheckBox x:Name="ReleaseNotRequiredCheck"
                                      Content="Not Required (Provisional)"
                                      IsChecked="True"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>

                            <CheckBox x:Name="ReleaseCheckCheck"
                                      Content="Release Needs Review"
                                      IsChecked="True"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>                            

                            <CheckBox x:Name="ReleaseUnclearCheck"
                                      Content="Unclear"
                                      IsChecked="True"
                                      Checked="Filter_Changed"
                                      Unchecked="Filter_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,6,0,8"/>

                    <WrapPanel>
                        <StackPanel Margin="4,0,20,4">
                            <TextBlock Text="Minimum Stock Potential (0–10)"/>

                            <TextBox x:Name="MinStockBox"
                                     Text="0"
                                     Width="100"
                                     TextChanged="ScoreFilter_Changed"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ResultsGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="76"
                      SelectionChanged="ResultsGrid_SelectionChanged"
                      Background="White"
                      BorderThickness="0">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Select"
                                             Width="65"
                                             IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Focusable="False">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="1.8"
                                                        ScaleY="1.8"/>
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Preview"
                                             Width="85"
                                             IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Thumbnail}"
                                       Width="70"
                                       Height="64"
                                       Stretch="Uniform"
                                       Margin="3"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="File"
                                        Binding="{Binding FileName}"
                                        Width="2*"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Stock Potential"
                                        Binding="{Binding StockPotential, StringFormat={}{0}/10}"
                                        Width="100"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="People"
                                        Binding="{Binding PeopleStatus}"
                                        Width="155"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Release Status"
                                        Binding="{Binding ReleaseStatus}"
                                        Width="175"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Recommendation"
                                        Binding="{Binding Recommendation}"
                                        Width="145"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="#D8DEE8"/>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="12"
                    Margin="8,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Image Preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="PreviewFileText"
                                   Text="No image selected"
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"
                                   Margin="0,5,0,10"/>
                    </StackPanel>

                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>